{
    "name": "ivancraft623/pathfinder",
    "description": "Pathfinder library for PocketMine-MP.",
    "type": "library",
    "license": "GPL-3.0",
    "require": {
        "php": "^8.1",
        "ext-igbinary": "*"
    },
    "require-dev": {
        "pocketmine/pocketmine-mp": "^5.30.0",
        "phpstan/phpstan": "2.3.2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "IvanCraft623\\Pathfinder\\": "src/IvanCraft623/Pathfinder/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IvanCraft623\\Pathfinder\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --bootstrap vendor/autoload.php --fail-on-warning --no-progress tests/phpunit"
    },
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "IvanCraft623\\Pathfinder"
        }
    }
}
